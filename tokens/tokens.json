{
  "$description": "BugWar design tokens v1.0. Palette 'Deep Teal & Honey'. Values sampled from the approved Home screen concept.",
  "color": {
    "background": {
      "base":      { "value": "#004A56", "use": "фон экранов" },
      "pattern":   { "value": "#0A5A66", "use": "линии крупного узора сот на фоне (низкий контраст)" },
      "glow":      { "value": "#FFD36A", "use": "тёплое световое пятно за главным объектом, прозрачность 20–35%" }
    },
    "surface": {
      "panel":       { "value": "#003A44", "use": "плашки, панели, неактивные вкладки" },
      "panelEdge":   { "value": "#0F5A66", "use": "тонкая светлая линия по верхнему краю панели (1–2 px)" },
      "panelLip":    { "value": "#00191E", "use": "нижний «бортик» объёма панели (4–6 px)" },
      "well":        { "value": "#00252C", "use": "утопленные колодцы: счётчики валют, прогресс-бары" },
      "button":      { "value": "#005564", "use": "второстепенные и иконочные кнопки (стрелки, почта, меню)" },
      "buttonLip":   { "value": "#00303A", "use": "бортик второстепенной кнопки" }
    },
    "primary": {
      "top":    { "value": "#FFC51B", "use": "главная кнопка, активная вкладка: верх градиента" },
      "bottom": { "value": "#FF8C00", "use": "главная кнопка: низ градиента" },
      "lip":    { "value": "#B14B00", "use": "бортик главной кнопки" },
      "spark":  { "value": "#FFF3C4", "use": "маленькая точка-блик в углу главной кнопки (единственный блик)" }
    },
    "accent": {
      "mint":     { "value": "#4CF0C0", "use": "заливка прогресса (опыт, миссии)" },
      "mintDark": { "value": "#22B88E", "use": "низ градиента прогресса" },
      "gold":     { "value": "#FFD23F", "use": "награды, звёзды, кубки" }
    },
    "status": {
      "badge":  { "value": "#F42C2C", "use": "только значки уведомлений" },
      "plus":   { "value": "#30D030", "use": "только кнопки «+» у валют" },
      "locked": { "value": "#6E8A8E", "use": "замки и закрытый контент" }
    },
    "text": {
      "primary":   { "value": "#FFFFFF" },
      "secondary": { "value": "#D2E2E0", "use": "неактивные вкладки, подписи" },
      "muted":     { "value": "#9DBDBD", "use": "закрытое, второстепенное" },
      "cream":     { "value": "#F6F0DE", "use": "мелкий текст на тёмном" },
      "outline":   { "value": "#08242C", "use": "обводка текста (тонкая)" },
      "shadow":    { "value": "#051A20", "use": "жёсткая тень текста вниз, без размытия" }
    }
  },
  "typography": {
    "display": {
      "font": "fonts/BugWarDisplay-Regular.ttf",
      "use": "крупные элементы: заголовки, кнопки, вкладки, названия локаций, имя игрока",
      "slant": 0.12,
      "outlineWidthPx": 2,
      "shadowOffsetPx": [0, 3],
      "sizes": { "hero": 72, "button": 48, "title": 36, "tab": 28 }
    },
    "body": {
      "font": "fonts/Rubik-Black.ttf",
      "use": "цифры, счётчики, мелкие подписи, описания",
      "slant": 0,
      "outlineWidthPx": 1,
      "shadowOffsetPx": [0, 2],
      "sizes": { "counter": 24, "label": 20, "small": 16 }
    },
    "$note": "Размеры указаны в единицах Canvas при эталонном разрешении 1920x1080."
  },
  "shape": {
    "radius": { "panel": 18, "button": 16, "pill": 999 },
    "lip": { "panel": 5, "button": 6 },
    "topEdge": 2
  },
  "spacing": { "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 32, "xxl": 48 },
  "touch": { "minTarget": 96, "$note": "минимальная зона нажатия в единицах Canvas (≈ 9 мм на телефоне)" }
}
